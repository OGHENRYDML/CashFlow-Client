# Generated by `cashfl0w init` — never commit the real .env file.

# The agent's own non-custodial EVM wallet. The private key never leaves this machine.
CASHFL0W_PRIVATE_KEY=0x...
CASHFL0W_ADDRESS=0x...

# EVM network the agent operates on, as a CAIP-2 id.
# Use eip155:84532 (Base Sepolia) while testing, eip155:8453 (Base mainnet) in production.
CASHFL0W_NETWORK=eip155:84532

# The agent's own non-custodial Solana wallet (base58 secret key). Optional —
# only needed if the agent also charges/pays over x402 on Solana.
# CASHFL0W_SOLANA_PRIVATE_KEY=
# CASHFL0W_SOLANA_ADDRESS=
# CASHFL0W_SOLANA_NETWORK=solana:EtWTRABZaYq6iMfeYKouRu166VU2xqa1

# x402 facilitator. Leave unset to use sane defaults, no signup needed either way:
#   - testnet networks -> the public https://x402.org/facilitator (Base Sepolia)
#   - mainnet networks -> https://pay.openfacilitator.io (free, no account, no API key)
# CASHFL0W_FACILITATOR_URL=https://pay.openfacilitator.io

# `cashfl0w sweep` destinations — the owner's own wallets, outside CASHFL0W's reach.
CASHFL0W_SWEEP_TO=0x...
# CASHFL0W_SOLANA_SWEEP_TO=...

# Optional: sweep automatically once the wallet's balance of this token crosses
# this threshold (in whole units, e.g. "25" for 25 USDC). Leave unset to only
# sweep on explicit command. Applies to both `sweep` and `sweep --chain solana`.
# CASHFL0W_SWEEP_THRESHOLD=25

# Optional, EVM only: convert non-USDC balances to USDC via 0x before sweeping,
# taking a CASHFL0W fee on the way through. 0 disables the swap step entirely.
# 0x doesn't operate on Solana, so `sweep --chain solana` never swaps.
# CASHFL0W_SWAP_FEE_BPS=0
# CASHFL0W_SWAP_FEE_RECIPIENT=0x...
# ZEROX_API_KEY=
